# Skopiuj do .env i wypelnij wlasnymi wartosciami - PRAWDZIWY .env
# NIGDY nie trafia do repo (jest w .gitignore).

# --- Wymagane, losowe (wygeneruj np. `openssl rand -hex 16`) ---
USC_DB_PASSWORD=
# Login/haslo do panelu USC (dashboard + /settings) - admin, HTTP Basic Auth
USC_ADMIN_USER=admin
USC_ADMIN_PASSWORD=
# Token wewnetrzny, wspoldzielony backend<->collector, chroni endpointy
# /ingest/* (port backendu jest wystawiony na hosta!) - wygeneruj np.
# `openssl rand -hex 24`
USC_INTERNAL_TOKEN=

# --- Jednorazowy seed przy PIERWSZYM starcie (potem edytuj w panelu /settings) ---
# IP serwera unRAID
USC_UNRAID_HOST=192.168.1.10
# Klucz API unRAID - rola VIEWER (read-only), patrz docs/INSTALL.md krok 4
USC_UNRAID_API_KEY=
# Token bota Telegram (z @BotFather) - opcjonalne, bez tego brak alertow
USC_TELEGRAM_BOT_TOKEN=
# chat_id odbiorcy alertow - opcjonalne
USC_TELEGRAM_CHAT_ID=

# --- Deploy-time (nie zmienia sie z panelu, wymaga przebudowy kontenera) ---
# Port na ktorym dashboard USC bedzie dostepny (host:port -> kontener:8000)
USC_WEB_PORT=8420
