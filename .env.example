# Skopiuj do .env i wypelnij wlasnymi wartosciami - PRAWDZIWY .env
# NIGDY nie trafia do repo (jest w .gitignore).

# IP serwera unRAID (GraphQL API + SSH do pluginu USC)
USC_UNRAID_HOST=192.168.1.10

# Klucz API unRAID - rola VIEWER (read-only), patrz docs/INSTALL.md krok 2
USC_UNRAID_API_KEY=

# Haslo dla bazy PostgreSQL backendu USC (wybierz wlasne, silne)
USC_DB_PASSWORD=

# Token bota Telegram (z @BotFather) - opcjonalne, bez tego brak alertow
USC_TELEGRAM_BOT_TOKEN=
# chat_id odbiorcy alertow (Twoje ID albo ID grupy) - opcjonalne
USC_TELEGRAM_CHAT_ID=

# Port na ktorym dashboard USC bedzie dostepny (host:port -> kontener:8000)
USC_WEB_PORT=8420
